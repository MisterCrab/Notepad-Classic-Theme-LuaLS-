	"tokenColors": [
		{
			"name": "Comments",
			"scope": ["comment"],
			"settings": {
				"fontStyle": "",
				"foreground": "#008000"
			}
		},
		{
			"name": "Comments: Documentation",
			"scope": [
				"comment.documentation",
				"comment.block.documentation",
				"comment.block.javadoc",
				"comment.line.double-slash.documentation",
				"punctuation.definition.block.tag.jsdoc",
				"storage.type.class.jsdoc"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#008080"
			}
		},
		{
			"name": "Lua: Doc comments → green",
			"scope": ["comment.line.double-dash.documentation.lua"],
			"settings": {
				"fontStyle": "",
				"foreground": "#008000"
			}
		},
		{
			"name": "Comments: nested scopes → green",
			"scope": [
				"comment support",
				"comment storage",
				"comment storage.type",
				"comment entity",
				"comment variable",
				"comment keyword.operator",
				"comment support.function.library-blue.lua",
				"comment support.function.library-purple.lua",
				"comment support.other.namespace-blue.lua",
				"comment support.other.namespace-purple.lua",
				"comment entity.other.metafield.lua",
				"comment support.function.lua",
				"comment punctuation.definition.block.tag"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#008000"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"constant.language",
				"storage.modifier.extends",
				"storage.type.namespace.directive",
				"variable.language",
				"keyword.operator.delete"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#0000ff"
			}
		},
		{
			"name": "Java: Imports",
			"scope": [
				"storage.modifier.import",
				"storage.modifier.package"
			],
			"settings": {
				"foreground": "#000000"
			}
		},
		{
			"name": "Numbers",
			"scope": ["constant.numeric"],
			"settings": {
				"foreground": "#ff8000"
			}
		},
		{
			"name": "Strings, Characters",
			"scope": [
				"string.quoted.double",
				"string.quoted.single"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#808080"
			}
		},
		{
			"name": "Strings: Markup Languages",
			"scope": [
				"string.quoted.double.xml",
				"string.quoted.double.html"
			],
			"settings": {
				"fontStyle": "bold",
				"foreground": "#8000ff"
			}
		},
		{
			"name": "String: templates",
			"scope": ["string.template"],
			"settings": {
				"fontStyle": "",
				"foreground": "#000080"
			}
		},
		{
			"name": "Punctuation: Bold",
			"scope": [
				"punctuation.bracket",
				"punctuation.separator",
				"punctuation.terminator",
				"punctuation.section",
				"punctuation.definition.parameters",
				"punctuation.definition.begin",
				"punctuation.definition.end",
				"punctuation.definition.block",
				"meta.brace.round",
				"meta.brace.square",
				"storage.type.function.arrow"
			],
