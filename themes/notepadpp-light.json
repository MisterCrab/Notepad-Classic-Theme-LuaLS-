				"fontStyle": "bold",
				"foreground": "#000080"
			}
		},
		{
			"name": "Operators",
			"scope": ["keyword.operator"],
			"settings": {
				"fontStyle": "",
				"foreground": "#000080"
			}
		},
		{
			"name": "C++: Preprocessor Directives",
			"scope": [
				"keyword.control.directive",
				"meta.preprocessor"
			],
			"settings": {
				"fontStyle": "",
				"foreground": "#804000"
			}
		},
		{
			"name": "Java: Storage Modifier",
			"scope": [
				"storage.modifier",
				"keyword.other.package",
				"storage.type"
